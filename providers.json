{
  "_comment": "Single source of truth for supported model providers. Read by the Python gateway (runtime/providers/provider_factory.py) and the Next.js control plane (lib/providers/registry.ts), following the same shared-file pattern as plans.json and pricing.json. Adding a provider is one entry here — no new class, no new UI list.",
  "_api": "`api` selects the wire protocol. Almost every vendor now speaks OpenAI's chat-completions shape, so `openai` entries need nothing but a baseUrl and are served by the one shared adapter. `anthropic` and `gemini` have genuinely different request/response shapes and keep native adapters — their baseUrl is null because those adapters own their endpoints.",
  "_baseUrlEnv": "Optional. When present the environment variable wins over `baseUrl`, which is how self-hosted and private endpoints are pointed somewhere real without a code change.",
  "_keyPrefixes": "Empty means the vendor publishes no stable key prefix, so only length and whitespace are checked. A prefix rule invented for a vendor that has none would reject valid keys, which is worse than the weaker check.",
  "_pricing": "A provider being routable does not mean its models are priced. Cost attribution needs the model in pricing.json; anything missing is recorded with cost 0 and flagged by runtime/telemetry/pricing.py. See docs/PROVIDERS.md.",
  "providers": {
    "openai": {
      "label": "OpenAI",
      "api": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "keyEnv": "OPENAI_API_KEY",
      "keyPrefixes": ["sk-"],
      "keyRequired": true,
      "docsUrl": "https://platform.openai.com/api-keys"
    },
    "anthropic": {
      "label": "Anthropic",
      "api": "anthropic",
      "baseUrl": null,
      "keyEnv": "ANTHROPIC_API_KEY",
      "keyPrefixes": ["sk-ant-"],
      "keyRequired": true,
      "docsUrl": "https://console.anthropic.com/settings/keys"
    },
    "gemini": {
      "label": "Google Gemini",
      "api": "gemini",
      "baseUrl": null,
      "keyEnv": "GEMINI_API_KEY",
      "keyPrefixes": ["AIza"],
      "keyRequired": true,
      "docsUrl": "https://aistudio.google.com/apikey"
    },
    "grok": {
