generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String               @id @default(uuid())
  name                 String
  slug                 String               @unique
  tier                 OrgTier              @default(STARTUP)
  kmsKeyArn            String?
  enforceSso           Boolean              @default(false)
  dailyBudget          Decimal              @default(0) @db.Decimal(18, 4)
  monthlyBudget        Decimal              @default(0) @db.Decimal(18, 4)
  currentDailySpend    Decimal              @default(0) @db.Decimal(18, 4)
  currentMonthlySpend  Decimal              @default(0) @db.Decimal(18, 4)
  // Plan request quota (plans.json → monthlyRequests). Incremented atomically
  // by the gateway on every accepted request and zeroed by the reset-budgets
  // cron on the 1st, alongside the monthly spend window.
  currentMonthlyRequests Int                @default(0)
  pauseReason          String?
  pausedAt             DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  stripeCustomerId     String?              @unique
  stripeSubscriptionId String?              @unique
  subscriptionStatus   String               @default("FREE")
  subscriptionTier     String               @default("FREE")
  currentPeriodEnd     DateTime?
  // Set when the customer cancels: Stripe keeps the subscription active and
  // paid-for until currentPeriodEnd, then deletes it. Stored so the billing page
  // can say "cancels on the 14th" rather than "renews on the 14th", which is the
  // opposite of the truth and the kind of thing that becomes a chargeback.
  cancelAtPeriodEnd    Boolean              @default(false)
  status               String               @default("ACTIVE")
  activityLogs         ActivityLog[]
  agents               Agent[]
  ledgerEntries        LedgerEntry[]
  alerts               Alert[]
  ApiKey               ApiKey[]
  budgetViolations     BudgetViolation[]
  invites              Invite[]
  policies             Policy[]
  providerCredentials  ProviderCredential[]
  requestLogs          RequestLog[]
  spendLogs            SpendLog[]
  subscription         Subscription?
  usageMetrics         UsageMetrics[]
  users                User[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  // One of the values in lib/auth/roles.ts: OWNER | ADMIN | DEVELOPER | VIEWER.
  // Kept as String rather than an enum so adding a role later does not require
  // a migration that locks the table.
  role           String       @default("DEVELOPER")
  organizationId String
  createdAt      DateTime     @default(now())
  fullName       String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  sentInvites    Invite[]     @relation("InviteSender")

  @@index([organizationId])
}

/// A pending invitation for someone to join an organization.
///
/// The raw token is emailed to the invitee and never stored: only its SHA-256
/// hash lives here, so a database leak does not hand an attacker a set of
/// working join links.
model Invite {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  /// Role the invitee receives on acceptance. Validated against lib/auth/roles.ts.
  role           String       @default("DEVELOPER")
  /// SHA-256 of the raw token. Unique so acceptance is a single indexed lookup.
  tokenHash      String       @unique
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String?
  invitedBy      User?        @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// At most one live invite per address per org. Re-inviting replaces the old
  /// row rather than accumulating duplicates that all still work.
  @@unique([organizationId, email])
  @@index([organizationId, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Agent {
  id                  String            @id @default(uuid())
  name                String
  organizationId      String
  clientId            String            @unique
  clientSecret        String
  apiKey              String            @unique
  scopes              String[]          @default(["llm:read", "llm:write"])
  status              AgentStatus       @default(ACTIVE)
  dailyBudget         Decimal           @db.Decimal(18, 4)
  monthlyBudget       Decimal           @db.Decimal(18, 4)
  currentDailySpend   Decimal           @default(0) @db.Decimal(18, 4)
  currentMonthlySpend Decimal           @default(0) @db.Decimal(18, 4)
  pauseReason         String?
  pausedAt            DateTime?
  pausedBy            String?
  createdAt           DateTime          @default(now())
  activityLogs        ActivityLog[]
  organization        Organization      @relation(fields: [organizationId], references: [id])
  alerts              Alert[]
  budgetViolations    BudgetViolation[]
  policies            Policy[]
  requestLogs         RequestLog[]
  spendLogs           SpendLog[]
  usageMetrics        UsageMetrics[]

  @@index([organizationId, status])
}

model Policy {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  agentId        String?
  ruleDsl        String
  action         PolicyAction @default(ALLOW)
  priority       Int          @default(100)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  agent          Agent?       @relation(fields: [agentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, priority])
}

model SpendLog {
  id             String       @id @default(uuid())
  agentId        String
  organizationId String
  model          String
  provider       String
  tokensIn       Int
  tokensOut      Int
  cost           Decimal      @db.Decimal(18, 8)
  metadata       Json?
  createdAt      DateTime     @default(now())
  agent          Agent        @relation(fields: [agentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

model ActivityLog {
  id             String       @id @default(uuid())
  timestamp      DateTime     @default(now())
  organizationId String
  agentId        String?
  action         String
  status         String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  agent          Agent?       @relation(fields: [agentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, timestamp])
}

/// Append-only, tamper-evident enforcement ledger (LEDGER-6).
/// Each row chains to its predecessor via (sequence, prevHash, recordHash) and
/// is Ed25519-signed (runtime/ledger, lib/ledger). Monetary + timestamp fields
/// are stored as the EXACT canonical strings used to compute recordHash, so the
/// hash is reproducible from a row by the cross-language verifier. DB-level WORM
/// (REVOKE + trigger) and Merkle/anchor are added in LEDGER-9..11. agentId is a
/// plain string (no FK) so agent lifecycle changes never mutate the ledger.
enum LedgerVerdict {
  ALLOWED
  CAPPED
  BLOCKED
  REROUTED
}

model LedgerEntry {
  id                 String        @id @default(uuid())
  organizationId     String
  sequence           BigInt
  prevHash           String
  recordHash         String        @unique
  signature          String
  signingKeyId       String
  schemaVersion      Int           @default(1)
  agentId            String?
  actorAuthorizer    String?
  policyId           String
  verdict            LedgerVerdict
  provider           String
  model              String
  currency           String        @default("USD")
  estimatedCost      String
  cost               String?
  recordTimestamp    String
  enforcedBeforeCall Boolean
  enforcementProof   Json
  createdAt          DateTime      @default(now())
  organization       Organization  @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sequence])
  @@index([organizationId, createdAt])
}

model Subscription {
  id               String       @id @default(uuid())
  organizationId   String       @unique
  stripeId         String?      @unique
  plan             String       @default("FREE")
  status           String       @default("ACTIVE")
  currentPeriodEnd DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id])
}

model RequestLog {
  id                 String       @id @default(uuid())
  timestamp          DateTime     @default(now())
  agentId            String
  organizationId     String
  provider           String
  model              String
  requestPayloadSize Int          @default(0)
  statusCode         Int          @default(200)
  latencyMs          Int          @default(0)
  ipAddress          String?
  createdAt          DateTime     @default(now())
  agent              Agent        @relation(fields: [agentId], references: [id])
  organization       Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, timestamp])
}

model UsageMetrics {
  id             String       @id @default(uuid())
  agentId        String
  organizationId String
  date           DateTime     @default(now()) @db.Date
  totalRequests  Int          @default(0)
  totalTokens    Int          @default(0)
  totalCost      Decimal      @default(0) @db.Decimal(18, 4)
  agent          Agent        @relation(fields: [agentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([agentId, date])
  @@index([organizationId, date])
}

model Alert {
  id             String       @id @default(uuid()) @db.VarChar
  organizationId String       @db.VarChar
  agentId        String?      @db.VarChar
  type           String       @db.VarChar
  severity       String?      @db.VarChar
  title          String       @db.VarChar
  message        String       @db.VarChar
  metadata       Json?        @db.Json
  resolved       Boolean?
  createdAt      DateTime?    @db.Timestamp(6)
  notifiedAt     DateTime?    @db.Timestamp(6)
  agent          Agent?       @relation(fields: [agentId], references: [id], onUpdate: NoAction)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model BudgetViolation {
  id             String       @id @default(uuid())
  organizationId String
  agentId        String?
  violationType  String
  currentSpend   Decimal      @db.Decimal(18, 4)
  budgetLimit    Decimal      @db.Decimal(18, 4)
  timestamp      DateTime     @default(now())
  agent          Agent?       @relation(fields: [agentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, timestamp])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  keyHash        String       @unique
  lastUsedAt     DateTime?
  revoked        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model ProviderCredential {
  id              String       @id @default(uuid())
  organizationId  String
  provider        String
  encryptedApiKey String
  status          String       @default("CONNECTED")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  keyLast4        String?
  lastTestedAt    DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model Lead {
  id           String   @id @default(uuid())
  type         LeadType @default(DEMO)
  name         String
  email        String
  company      String?
  monthlySpend String?
  message      String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

enum OrgTier {
  STARTUP
  GROWTH
  ENTERPRISE
  VPC
  FREE
}

enum AgentStatus {
  ACTIVE
  PAUSED
  QUARANTINED
  TERMINATED
}

enum PolicyAction {
  ALLOW
  DENY
  REQUIRE_APPROVAL
  FLAG
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum LeadType {
  DEMO
  CONTACT
}
